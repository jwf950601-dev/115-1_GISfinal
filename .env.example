# 複製成 .env 後填入自己的值；.env 已被 .gitignore 排除，不會上傳。
# Render 上改在 Dashboard → Environment 設定；GitHub Actions 改在 Settings → Secrets。

# TDX 運輸資料流通服務
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 中央氣象署開放資料平臺授權碼
CWA_API_KEY=

# Supabase（PostgreSQL）連線字串，例如 postgresql://postgres:密碼@主機:5432/postgres
DATABASE_URL=

# Nominatim 要求可辨識的 User-Agent（寫專案名稱即可）
NOMINATIM_USER_AGENT=lastmile-taipei-course-project
