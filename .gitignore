# 金鑰與本機設定（絕對不能上傳）
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Jupyter / Colab
.ipynb_checkpoints/

# 文獻 PDF 有著作權，不上傳；清單見 02_Document/README.md
